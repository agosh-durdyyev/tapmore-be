TZ=UTC
PORT=3333
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
APP_KEY=
APP_URL=http://127.0.0.1:3333
SESSION_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tapmore
DB_PASSWORD=tapmore_local
DB_DATABASE=tapmore
DB_SSL=false
CORS_ORIGIN=http://127.0.0.1:4317,http://127.0.0.1:4318,http://localhost:3000,http://localhost:5173,https://app.tapmore.link
# Passwordless sign-in
# Google: OAuth "Web application" client ID from console.cloud.google.com
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Apple: the Services ID used by Sign in with Apple JS
# APPLE_CLIENT_IDS=link.tapmore.web
# Email codes are logged to the console when RESEND_API_KEY is unset (development only).
# RESEND_API_KEY=
# MAIL_FROM=TapMore <hello@tapmore.link>
# Optional until image uploads are enabled; token needs Images Write access.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_IMAGES_TOKEN=
# AI import and title/bio suggestions. Without a key the AI endpoints answer 503 AI_NOT_CONFIGURED.
# Get one at platform.deepseek.com → API keys.
# DEEPSEEK_API_KEY=sk-...
# Optional: DEEPSEEK_MODEL (default deepseek-chat), DEEPSEEK_BASE_URL (default https://api.deepseek.com).
# Optional daily caps across all users / signed-out users (defaults 2000 / 500).
# AI_DAILY_LIMIT=2000
# AI_ANON_DAILY_LIMIT=500
